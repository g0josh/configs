# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=2AD1-7E1D                            /boot/efi      vfat    umask=0077 0 2
UUID=851ecae6-7b93-4980-9485-1be1f0176a49 /              ext4    defaults,noatime 0 1
# /dev/sdb2 storage NTFS partition shared with Windows
UUID=701A66371A65FA8C /mnt/storage ntfs-3g uid=1000,gid=1000,umask=0022 0 0
# /dev/sda2 media NTFS partition shared with Windows
UUID=268A20F48A20C263 /mnt/media ntfs-3g uid=1000,gid=1000,umask=0022 0 0

